{
  "name": "@vl/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db": "node scripts/database.mjs serve",
    "db:stop": "node scripts/database.mjs stop",
    "db:migrate": "node scripts/database.mjs run prisma migrate dev",
    "db:deploy": "node scripts/database.mjs run prisma migrate deploy",
    "db:seed": "node scripts/database.mjs run tsx prisma/seed.ts",
    "db:demo": "node scripts/database.mjs run tsx prisma/demo.ts",
    "db:studio": "prisma studio",
    "dev": "wait-on -t 120000 tcp:127.0.0.1:5433 && nest start --watch",
    "build": "prisma generate && nest build",
    "start:prod": "wait-on -t 120000 tcp:127.0.0.1:5433 && node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  }
}
