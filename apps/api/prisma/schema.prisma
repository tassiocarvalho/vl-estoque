generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários e acesso ────────────────────────────────────────────────────────

enum Role {
  ADMIN // Administrador (dono)
  MANAGER // Gerente: relatórios e autorização de descontos/cancelamentos no caixa
  STOCKIST // Estoquista
  CASHIER // Operador de caixa
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  username            String    @unique
  /// Usado só para recuperar a senha. Obrigatório para administradores.
  email               String?   @unique
  passwordHash        String
  pinHash             String?
  role                Role
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Incrementado no logout, troca de senha ou desativação: invalida sessões antigas.
  tokenVersion        Int       @default(0)
  lastLoginAt         DateTime?
  /// Versão do Termo de Uso e Política de Privacidade aceita pelo usuário (LGPD).
  termsVersion        String?
  termsAcceptedAt     DateTime?
  /// Preenchido quando os dados pessoais foram anonimizados (LGPD, art. 18).
  anonymizedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  movements        StockMovement[]
  purchaseRequests PurchaseRequest[]
  auditLogs        AuditLog[]
  passwordResets   PasswordReset[]

  cashSessionsOpened CashSession[]  @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]  @relation("CashSessionClosedBy")
  cashMovements      CashMovement[] @relation("CashMovementUser")
  cashMovementsAuth  CashMovement[] @relation("CashMovementAuthorizer")
  sales              Sale[]         @relation("SaleOperator")
  salesAuthorized    Sale[]         @relation("SaleAuthorizer")
  salesCanceled      Sale[]         @relation("SaleCanceledBy")

  returnsMade       SaleReturn[]      @relation("SaleReturnUser")
  returnsAuthorized SaleReturn[]      @relation("SaleReturnAuthorizer")
  receiptsTaken     CustomerReceipt[] @relation("ReceiptUser")

  invoicesCreated   PurchaseInvoice[] @relation("InvoiceCreatedBy")
  invoicesFinalized PurchaseInvoice[] @relation("InvoiceFinalizedBy")

  @@map("users")
}

/// Código de recuperação de senha enviado por e-mail (guardado só como hash; vale 15 minutos).
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_resets")
}

// ─── Catálogo ─────────────────────────────────────────────────────────────────

/// Categoria (parentId nulo) ou subcategoria (parentId preenchido).
model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())

  @@index([parentId])
  @@map("categories")
}

enum Unit {
  UN
  KG
  G
  L
  ML
  M
  CX
  PCT
  DZ
}

model Product {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  sku                  String    @unique
  barcode              String?   @unique
  categoryId           String    @db.Uuid
  category             Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit                 Unit
  /// Desligado: o produto não usa consumo/prazo, não tem ponto de pedido nem gera solicitação automática.
  replenishmentEnabled Boolean   @default(true)
  avgDailyConsumption  Decimal   @db.Decimal(12, 3)
  maxDailyConsumption  Decimal   @db.Decimal(12, 3)
  leadTimeDays         Int
  /// Indicadores calculados pelo domínio (EM, ES e PP) — armazenados para filtros rápidos.
  minimumStock         Decimal   @db.Decimal(12, 3)
  safetyStock          Decimal   @db.Decimal(12, 3)
  reorderPoint         Decimal   @db.Decimal(12, 3)
  /// Saldo atual (cache). A fonte da verdade é a soma das movimentações.
  currentStock         Decimal   @default(0) @db.Decimal(12, 3)
  /// Custo médio ponderado (atualizado nas entradas por nota; 4 casas para não perder centavos no rateio).
  costPrice            Decimal   @default(0) @db.Decimal(14, 4)
  /// Custo unitário da última entrada por nota.
  lastCost             Decimal   @default(0) @db.Decimal(14, 4)
  /// Preço de venda em reais (2 casas): o usado no caixa.
  salePrice            Decimal   @default(0) @db.Decimal(12, 2)
  /// Preenchido quando o produto vai para a lixeira.
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  movements        StockMovement[]
  purchaseRequests PurchaseRequest[]
  saleItems        SaleItem[]
  suppliers        ProductSupplier[]
  invoiceItems     PurchaseInvoiceItem[]
  returnItems      SaleReturnItem[]

  @@index([deletedAt])
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// ─── Movimentação de estoque (livro de registros imutável) ────────────────────

enum MovementType {
  IN_PURCHASE // Entrada: pedido recebido
  IN_RETURN // Entrada: retorno ao estoque
  IN_ADJUSTMENT // Entrada: ajuste / estoque inicial
  IN_SALE_CANCEL // Entrada: estorno de venda cancelada no caixa
  IN_SALE_RETURN // Entrada: devolução de venda (troca)
  OUT_SALE // Saída: venda
  OUT_LOSS // Saída: perda, quebra ou vencimento
  OUT_ADJUSTMENT // Saída: ajuste de inventário
}

enum MovementSource {
  APP
  PDV
}

model StockMovement {
  /// Gerado no dispositivo: permite sincronização offline sem duplicar registros.
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @db.Uuid
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MovementType
  quantity     Decimal        @db.Decimal(12, 3)
  balanceAfter Decimal        @db.Decimal(12, 3)
  note         String?
  source       MovementSource @default(APP)
  userId       String?        @db.Uuid
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  occurredAt   DateTime
  createdAt    DateTime       @default(now())

  @@index([productId, occurredAt])
  @@index([occurredAt])
  @@map("stock_movements")
}

// ─── Solicitações de pedido ───────────────────────────────────────────────────

enum PurchaseRequestStatus {
  PENDING // Aguardando a gestão
  ORDERED // Pedido feito ao fornecedor
  RECEIVED // Mercadoria recebida
  CANCELED
}

model PurchaseRequest {
  id                String                @id @default(uuid()) @db.Uuid
  productId         String                @db.Uuid
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  status            PurchaseRequestStatus @default(PENDING)
  suggestedQuantity Decimal               @db.Decimal(12, 3)
  stockAtRequest    Decimal               @db.Decimal(12, 3)
  reorderPoint      Decimal               @db.Decimal(12, 3)
  note              String?
  /// Nulo quando a solicitação foi gerada automaticamente pelo sistema.
  createdById       String?               @db.Uuid
  createdBy         User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  closedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("purchase_requests")
}

// ─── Frente de caixa (PDV não fiscal) ─────────────────────────────────────────

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Turno de um caixa (terminal): da abertura com troco inicial até o fechamento com a contagem.
model CashSession {
  id             String            @id @default(uuid()) @db.Uuid
  /// Nome do terminal (ex.: "Caixa 01"). Só pode haver um turno aberto por terminal.
  terminal       String
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @db.Decimal(12, 2)
  openedById     String            @db.Uuid
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt       DateTime          @default(now())
  /// Preenchidos no fechamento (valores congelados para o relatório).
  closedById     String?           @db.Uuid
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt       DateTime?
  expectedCash   Decimal?          @db.Decimal(12, 2)
  countedCash    Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  closingSummary Json?
  closingNote    String?

  movements CashMovement[]
  sales     Sale[]
  returns   SaleReturn[]
  receipts  CustomerReceipt[]

  @@index([terminal, status])
  @@index([openedAt])
  @@map("cash_sessions")
}

enum CashMovementType {
  SUPPLY // Suprimento: entrada manual de dinheiro
  WITHDRAWAL // Sangria: retirada de dinheiro
}

model CashMovement {
  id             String           @id @default(uuid()) @db.Uuid
  sessionId      String           @db.Uuid
  session        CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  reason         String
  userId         String           @db.Uuid
  user           User             @relation("CashMovementUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Supervisor que autorizou (quando o operador não tinha permissão).
  authorizedById String?          @db.Uuid
  authorizedBy   User?            @relation("CashMovementAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum DiscountType {
  AMOUNT // Valor fixo em R$
  PERCENT // Percentual
}

/// Natureza da forma de pagamento: define regras (gaveta, troco) e agrupamentos nos relatórios.
enum PaymentKind {
  CASH // Dinheiro: entra na gaveta (dinheiro esperado do caixa)
  PIX
  CREDIT_CARD
  DEBIT_CARD
  VOUCHER // Vale-alimentação, vale-refeição...
  CHECK // Cheque
  OTHER
  STORE_CREDIT // Vale-troca / crédito do cliente: abate do saldo do vale
  ON_ACCOUNT // Fiado / crediário: vira conta a receber do cliente
}

/// Formas de pagamento da loja (configuráveis). Nunca são apagadas depois de usadas: só desativadas.
model PaymentMethod {
  id               String      @id @default(uuid()) @db.Uuid
  /// Código fixo das formas que vêm de fábrica (CASH, PIX...). Nulo nas criadas pela loja.
  code             String?     @unique
  name             String
  kind             PaymentKind
  active           Boolean     @default(true)
  /// Aceita valor maior que o devido, gerando troco (que sai da gaveta).
  allowsChange     Boolean     @default(false)
  /// Só pode ser usada em venda com cliente identificado.
  requiresCustomer Boolean     @default(false)
  /// Taxa da operadora (%) e prazo de recebimento (dias) — base do fluxo de caixa.
  feePercent       Decimal     @default(0) @db.Decimal(5, 2)
  settlementDays   Int         @default(0)
  /// Ordem no caixa (os primeiros recebem os atalhos F1–F4, F6–F9).
  position         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  payments SalePayment[]
  receipts CustomerReceipt[]

  @@map("payment_methods")
}

/// Venda não fiscal. O id é gerado no caixa: o reenvio offline não duplica a venda.
model Sale {
  id                     String        @id @db.Uuid
  /// Número sequencial exibido no comprovante.
  number                 Int           @unique @default(autoincrement())
  sessionId              String        @db.Uuid
  session                CashSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  operatorId             String        @db.Uuid
  operator               User          @relation("SaleOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  /// Cliente identificado (opcional) e cópia do nome/documento impressos no comprovante.
  customerId             String?       @db.Uuid
  customer               Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName           String?
  /// CPF/CNPJ do consumidor, só números ("CPF na nota").
  customerDocument       String?
  status                 SaleStatus    @default(COMPLETED)
  /// Soma dos itens antes de qualquer desconto.
  grossTotal             Decimal       @db.Decimal(12, 2)
  itemsDiscount          Decimal       @db.Decimal(12, 2)
  orderDiscountType      DiscountType?
  orderDiscountValue     Decimal?      @db.Decimal(12, 2)
  orderDiscount          Decimal       @db.Decimal(12, 2)
  total                  Decimal       @db.Decimal(12, 2)
  /// Soma do que o cliente entregou e o troco devolvido (só em dinheiro).
  paidTotal              Decimal       @db.Decimal(12, 2)
  change                 Decimal       @db.Decimal(12, 2)
  /// Supervisor que autorizou descontos acima do limite do operador.
  discountAuthorizedById String?       @db.Uuid
  discountAuthorizedBy   User?         @relation("SaleAuthorizer", fields: [discountAuthorizedById], references: [id], onDelete: Restrict)
  /// Itens retirados do cupom antes de finalizar (rastro para a auditoria).
  removedItems           Json?
  /// Registrada sem internet e sincronizada depois.
  offline                Boolean       @default(false)
  occurredAt             DateTime
  createdAt              DateTime      @default(now())
  canceledAt             DateTime?
  canceledById           String?       @db.Uuid
  canceledBy             User?         @relation("SaleCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  cancelReason           String?

  items       SaleItem[]
  payments    SalePayment[]
  returns     SaleReturn[]
  receivables Receivable[]

  @@index([sessionId])
  @@index([occurredAt])
  @@index([status, occurredAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id            String        @id @default(uuid()) @db.Uuid
  saleId        String        @db.Uuid
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  position      Int
  productId     String        @db.Uuid
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Cópia dos dados no momento da venda (o comprovante não muda se o cadastro mudar).
  productName   String
  sku           String
  unit          Unit
  quantity      Decimal       @db.Decimal(12, 3)
  unitPrice     Decimal       @db.Decimal(12, 2)
  /// Custo médio do produto no momento da venda (base da margem e do CMV).
  unitCost      Decimal       @db.Decimal(14, 4)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id              String        @id @default(uuid()) @db.Uuid
  saleId          String        @db.Uuid
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethodId String        @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  /// Cópia do nome e da natureza no momento da venda (o comprovante não muda se a forma for renomeada).
  methodName      String
  methodKind      PaymentKind
  /// Valor entregue pelo cliente nesta forma de pagamento.
  amount          Decimal       @db.Decimal(12, 2)
  /// Vale-troca usado (formas de natureza STORE_CREDIT).
  storeCreditId   String?       @db.Uuid
  storeCredit     StoreCredit?  @relation(fields: [storeCreditId], references: [id], onDelete: Restrict)
  /// Parcelas do fiado (formas de natureza ON_ACCOUNT).
  installments    Int?

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payments")
}

// ─── Pós-venda: devoluções, vale-troca e fiado ────────────────────────────────

/// Como o cliente é reembolsado na devolução.
enum RefundMethod {
  CASH // Dinheiro: sai da gaveta do caixa aberto
  ORIGINAL // Estorno na forma original (cartão, PIX): só registro
  STORE_CREDIT // Vale-troca / crédito para usar em outra compra
  ACCOUNT // Abate do fiado (venda feita no fiado)
}

/// Devolução (total ou parcial) de uma venda, inclusive depois do fechamento do turno. O id vem do caixa.
model SaleReturn {
  id               String       @id @db.Uuid
  number           Int          @unique @default(autoincrement())
  saleId           String       @db.Uuid
  sale             Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  /// Caixa em que a devolução foi feita (o dinheiro devolvido sai dele).
  sessionId        String?      @db.Uuid
  session          CashSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customerId       String?      @db.Uuid
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId           String       @db.Uuid
  user             User         @relation("SaleReturnUser", fields: [userId], references: [id], onDelete: Restrict)
  authorizedById   String?      @db.Uuid
  authorizedBy     User?        @relation("SaleReturnAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict)
  reason           String
  refundMethod     RefundMethod
  /// Estorno na forma original: nome da forma (ex.: "Cartão de crédito").
  refundMethodName String?
  total            Decimal      @db.Decimal(12, 2)
  /// Vale-troca gerado (reembolso em crédito).
  storeCreditId    String?      @unique @db.Uuid
  storeCredit      StoreCredit? @relation(fields: [storeCreditId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())

  items SaleReturnItem[]

  @@index([saleId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id          String     @id @default(uuid()) @db.Uuid
  returnId    String     @db.Uuid
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId  String     @db.Uuid
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  productId   String     @db.Uuid
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  unit        Unit
  quantity    Decimal    @db.Decimal(12, 3)
  /// Valor devolvido ao cliente por este item (proporcional ao que ele pagou).
  amount      Decimal    @db.Decimal(12, 2)
  unitCost    Decimal    @db.Decimal(14, 4)
  /// Volta ao estoque (padrão) ou é registrado como perda (produto avariado).
  restock     Boolean    @default(true)

  @@index([returnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

/// Vale-troca / crédito: saldo com código único, ao portador ou de um cliente.
model StoreCredit {
  id          String    @id @default(uuid()) @db.Uuid
  /// Código impresso no vale (ex.: VT-7KQ3M9XP).
  code        String    @unique
  customerId  String?   @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount      Decimal   @db.Decimal(12, 2)
  balance     Decimal   @db.Decimal(12, 2)
  expiresAt   DateTime? @db.Date
  note        String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  canceledAt  DateTime?

  saleReturn SaleReturn?
  entries    StoreCreditEntry[]
  payments   SalePayment[]

  @@index([customerId])
  @@map("store_credits")
}

/// Extrato do vale: emissão, usos em vendas, estornos e cancelamento.
model StoreCreditEntry {
  id        String      @id @default(uuid()) @db.Uuid
  creditId  String      @db.Uuid
  credit    StoreCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  /// ISSUE, REDEEM, REVERSAL ou CANCEL.
  type      String
  /// Positivo aumenta o saldo; negativo diminui.
  amount    Decimal     @db.Decimal(12, 2)
  saleId    String?     @db.Uuid
  userId    String?     @db.Uuid
  createdAt DateTime    @default(now())

  @@index([creditId])
  @@map("store_credit_entries")
}

enum ReceivableStatus {
  OPEN
  PAID
  CANCELED
}

/// Conta a receber do fiado: uma por parcela da venda.
model Receivable {
  id           String           @id @default(uuid()) @db.Uuid
  customerId   String           @db.Uuid
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleId       String?          @db.Uuid
  sale         Sale?            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  description  String
  installment  Int              @default(1)
  installments Int              @default(1)
  dueDate      DateTime         @db.Date
  amount       Decimal          @db.Decimal(12, 2)
  /// Quanto já foi recebido (baixa parcial).
  paidAmount   Decimal          @default(0) @db.Decimal(12, 2)
  status       ReceivableStatus @default(OPEN)
  paidAt       DateTime?
  canceledAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  allocations ReceiptAllocation[]

  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([saleId])
  @@map("receivables")
}

/// Recebimento do fiado no caixa (baixa total ou parcial, das parcelas mais antigas para as mais novas).
model CustomerReceipt {
  id              String        @id @db.Uuid
  number          Int           @unique @default(autoincrement())
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessionId       String        @db.Uuid
  session         CashSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId          String        @db.Uuid
  user            User          @relation("ReceiptUser", fields: [userId], references: [id], onDelete: Restrict)
  paymentMethodId String        @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  methodName      String
  methodKind      PaymentKind
  /// Valor abatido da dívida.
  amount          Decimal       @db.Decimal(12, 2)
  /// Valor entregue pelo cliente e troco (só em dinheiro).
  received        Decimal       @db.Decimal(12, 2)
  change          Decimal       @default(0) @db.Decimal(12, 2)
  occurredAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  allocations ReceiptAllocation[]

  @@index([customerId])
  @@index([sessionId])
  @@map("customer_receipts")
}

model ReceiptAllocation {
  id           String          @id @default(uuid()) @db.Uuid
  receiptId    String          @db.Uuid
  receipt      CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receivableId String          @db.Uuid
  receivable   Receivable      @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  amount       Decimal         @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([receivableId])
  @@map("receipt_allocations")
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

/// Cliente da loja. Nunca é apagado se tiver vendas: é inativado ou anonimizado (LGPD).
model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  /// CPF (11) ou CNPJ (14), só números.
  document         String?   @unique
  phone            String?
  email            String?
  birthDate        DateTime? @db.Date
  address          String?
  notes            String?
  active           Boolean   @default(true)
  /// LGPD: quando e por qual canal o cliente autorizou o cadastro; consentimento de marketing à parte.
  consentAt        DateTime?
  consentChannel   String?
  marketingConsent Boolean   @default(false)
  /// Preenchido quando os dados pessoais foram apagados a pedido do titular.
  anonymizedAt     DateTime?
  /// Limite do fiado (0 = fiado não liberado para o cliente).
  creditLimit      Decimal   @default(0) @db.Decimal(12, 2)
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sales        Sale[]
  returns      SaleReturn[]
  storeCredits StoreCredit[]
  receivables  Receivable[]
  receipts     CustomerReceipt[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

// ─── Compras: fornecedores e notas de entrada ─────────────────────────────────

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  /// Razão social (ou nome, se pessoa física).
  name         String
  tradeName    String?
  /// CNPJ (14) ou CPF (11), só números.
  document     String?  @unique
  phone        String?
  email        String?
  contactName  String?
  /// Prazo médio de entrega (dias).
  leadTimeDays Int?
  /// Condições de pagamento combinadas (ex.: "28/56 dias").
  paymentTerms String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products ProductSupplier[]
  invoices PurchaseInvoice[]
  payables Payable[]

  @@index([name])
  @@map("suppliers")
}

/// Produto comprado de um fornecedor: código do produto no fornecedor, conversão e último custo.
model ProductSupplier {
  productId      String    @db.Uuid
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String    @db.Uuid
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierCode   String?
  /// Unidades do produto em cada unidade comprada (ex.: caixa com 12 = 12).
  factor         Decimal   @default(1) @db.Decimal(12, 3)
  /// Último custo por unidade do produto (já com frete e descontos rateados).
  lastCost       Decimal?  @db.Decimal(14, 4)
  lastPurchaseAt DateTime?
  /// Fornecedor sugerido nas solicitações de pedido.
  preferred      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@id([productId, supplierId])
  @@index([supplierId, supplierCode])
  @@map("product_suppliers")
}

enum PurchaseInvoiceStatus {
  DRAFT // Em conferência: não mexe no estoque
  FINALIZED // Entrada lançada: estoque, custo médio e contas a pagar
  CANCELED
}

/// Entrada de mercadoria por nota (digitada ou importada do XML da NF-e).
model PurchaseInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  /// Número interno da entrada.
  number         Int                   @unique @default(autoincrement())
  supplierId     String?               @db.Uuid
  supplier       Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Número e série da nota do fornecedor.
  documentNumber String?
  series         String?
  /// Chave de acesso da NF-e (44 dígitos): impede importar a mesma nota duas vezes.
  accessKey      String?               @unique
  issueDate      DateTime?             @db.Date
  status         PurchaseInvoiceStatus @default(DRAFT)
  /// Valores da nota rateados no custo dos itens (proporcional ao valor de cada item).
  freight        Decimal               @default(0) @db.Decimal(12, 2)
  otherCosts     Decimal               @default(0) @db.Decimal(12, 2)
  discount       Decimal               @default(0) @db.Decimal(12, 2)
  /// Total impresso na nota, para conferência.
  declaredTotal  Decimal?              @db.Decimal(12, 2)
  /// Parcelas a pagar ([{ dueDate, amount }]); viram contas a pagar ao finalizar.
  installments   Json?
  notes          String?
  /// MANUAL ou XML.
  source         String                @default("MANUAL")
  createdById    String?               @db.Uuid
  createdBy      User?                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  finalizedById  String?               @db.Uuid
  finalizedBy    User?                 @relation("InvoiceFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  finalizedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items    PurchaseInvoiceItem[]
  payables Payable[]

  @@index([status, createdAt])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id           String          @id @default(uuid()) @db.Uuid
  invoiceId    String          @db.Uuid
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  /// Produto do cadastro (nulo enquanto o item importado do XML não foi associado).
  productId    String?         @db.Uuid
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Dados do item como vieram na nota.
  supplierCode String?
  description  String
  barcode      String?
  purchaseUnit String?
  /// Quantidade e custo na unidade da nota.
  quantity     Decimal         @db.Decimal(12, 3)
  unitCost     Decimal         @db.Decimal(14, 4)
  total        Decimal         @db.Decimal(12, 2)
  /// Unidades do produto em cada unidade da nota (estoque = quantidade × fator).
  factor       Decimal         @default(1) @db.Decimal(12, 3)

  @@index([invoiceId])
  @@index([productId])
  @@map("purchase_invoice_items")
}

// ─── Financeiro: contas a pagar ───────────────────────────────────────────────

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  /// Código das categorias de fábrica (MERCHANDISE = compra de mercadoria: vira custo, não despesa).
  code      String?  @unique
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  payables Payable[]

  @@map("expense_categories")
}

enum PayableStatus {
  OPEN
  PAID
  CANCELED
}

model Payable {
  id                String           @id @default(uuid()) @db.Uuid
  description       String
  categoryId        String           @db.Uuid
  category          ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId        String?          @db.Uuid
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Nota de entrada que gerou a conta (parcelas da nota).
  invoiceId         String?          @db.Uuid
  invoice           PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  documentNumber    String?
  installment       Int              @default(1)
  installments      Int              @default(1)
  dueDate           DateTime         @db.Date
  amount            Decimal          @db.Decimal(12, 2)
  status            PayableStatus    @default(OPEN)
  /// Baixa: data, valor pago (pode ter juros ou desconto) e forma de pagamento.
  paidAt            DateTime?        @db.Date
  paidAmount        Decimal?         @db.Decimal(12, 2)
  paymentMethodName String?
  notes             String?
  /// Comprovante anexado (imagem ou PDF, até 2 MB).
  attachment        Bytes?
  attachmentName    String?
  attachmentType    String?
  createdById       String?          @db.Uuid
  paidById          String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, dueDate])
  @@index([paidAt])
  @@index([invoiceId])
  @@map("payables")
}

// ─── Configuração e auditoria ─────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
