# ─── Banco de dados (PostgreSQL) ───────────────────────────────────────────────
# Em desenvolvimento o PostgreSQL roda embutido (scripts/database.mjs) usando estes dados.
# Em produção, aponte para um PostgreSQL gerenciado (Supabase, Neon, RDS...).
DATABASE_URL="postgresql://vl_estoque:__DB_PASSWORD__@127.0.0.1:5433/vl_estoque?schema=public"

# Pasta onde o PostgreSQL embutido guarda os dados.
# Vazio = %LOCALAPPDATA%\vl-estoque\pgdata (fora do OneDrive, para evitar corrompimento por sincronização).
DB_DATA_DIR=

# ─── Servidor ──────────────────────────────────────────────────────────────────
# development | production (em produção o CORS de desenvolvimento é desligado)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Origem do front-end em desenvolvimento (Vite). Em produção o front é servido pela própria API.
WEB_ORIGIN=http://localhost:5173

# ─── Segurança ─────────────────────────────────────────────────────────────────
# Segredo usado para assinar as sessões. Gerado automaticamente pelo "npm run setup".
JWT_SECRET=__JWT_SECRET__
# Duração da sessão (horas) — equivale a um turno de trabalho.
SESSION_HOURS=12
# true quando o sistema estiver publicado com HTTPS (obrigatório em produção).
COOKIE_SECURE=false

# Chave que o sistema de caixa (PDV) usa para consultar estoque e enviar vendas.
PDV_API_KEY=__PDV_API_KEY__

# Senha inicial do usuário "admin" (será obrigatório trocá-la no primeiro acesso).
ADMIN_INITIAL_PASSWORD=__ADMIN_PASSWORD__
